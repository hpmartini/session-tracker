#!/usr/bin/env -S python3 -I
"""Anwesenheit pro Tag aus events.sqlite. Aufruf: session-report [--bloecke] [--pause MIN] [--kurz STUNDEN] [--zeitraum NAME] [--hergeleitet] [--heute --json] [--selftest]"""
import calendar, datetime as dt, json, os, sqlite3, sys, time

GAP_MIN = 5  # Pausen darunter gelten als ein Block (Dashboard: Eingabefeld, gleicher Standard)
DERIVED_PAD = 300  # shortcut: feste ±5 min um jeden Beleg (Shell/Browser-Punkte haben keine Dauer); je Quelle eichen, wenn Blöcke zu grob wirken
DB = os.environ.get('SESSION_DB', os.path.expanduser('~/.local/share/session-tracker/events.sqlite'))  # Override für Tests und Demo-Daten
OPEN = {'start', 'unlock', 'wake', 'display_on'}
CLOSE = {'lock', 'sleep', 'display_off', 'logout', 'stop'}
MAX_GAP = 600  # Heartbeat alle 300 s; längere Funkstille = Agent tot (Absturz, Strom weg)


def intervals(rows, now):
    """rows: [(epoch, event)] sortiert -> [(von, bis)] in epoch."""
    out, since, last = [], None, None
    for ts, ev in rows:
        if since is not None and ts - last > MAX_GAP:
            out.append((since, last)); since = None
        if ev in OPEN and since is None:
            since = ts
        elif ev in CLOSE and since is not None:
            out.append((since, ts)); since = None
        last = ts
    if since is not None:
        out.append((since, now if now - last <= MAX_GAP else last))
    return [(a, b) for a, b in out if b > a]


def merge(ivs, gap):
    """Verschmilzt Intervalle, deren Pause kleiner als gap Sekunden ist."""
    out = []
    for a, b in sorted(ivs):
        if out and a - out[-1][1] < gap:
            out[-1] = (out[-1][0], max(out[-1][1], b))
        else:
            out.append((a, b))
    return out


def derived_blocks(db, cutoff, gap):
    """Aus `derived` (session-backfill) hergeleitete Blöcke vor cutoff; ab dort liefert der Tracker echte Daten."""
    try:
        belege = db.execute('SELECT ts_from, ts_to FROM derived WHERE ts_from < ?', (cutoff,)).fetchall()
    except sqlite3.OperationalError:  # Tabelle fehlt: noch kein Backfill gelaufen
        return []
    return merge([(a - DERIVED_PAD, min(b + DERIVED_PAD, cutoff)) for a, b in belege], gap)


KURZ_H = 1  # Standard: Tage mit weniger als so vielen Stunden zählen als "kurz" (--kurz / Dashboard-Feld überschreiben)


def year_stats(ivs, kurz=KURZ_H):
    """ivs: [(von, bis)] epoch -> [(jahr, tage, ø_h, kurze_tage, ø_h_ohne_kurze)]. Der Ø schließt kurze Tage ein, die Spalte rechts schließt sie aus."""
    tage = {}
    for d, parts in per_day(ivs).items():
        tage[d] = tage.get(d, 0) + sum((b - a).total_seconds() for a, b in parts) / 3600
    out = []
    for y in sorted({d.year for d in tage}):
        h = [v for d, v in tage.items() if d.year == y]
        lang = [v for v in h if v >= kurz]
        out.append((y, len(h), sum(h) / len(h), len(h) - len(lang), sum(lang) / len(lang) if lang else 0.0))
    return out


def _plus_months(d, n):
    y, m = divmod(d.year * 12 + d.month - 1 + n, 12)
    return dt.date(y, m + 1, min(d.day, calendar.monthrange(y, m + 1)[1]))


def period_ranges(today):
    """Zeiträume des Dashboards als [von, bis) in Datum. Woche ab Montag, Quartale = Kalenderquartale;
    "Letzte N Wochen/Monate" gleiten bis einschließlich heute, alle übrigen sind Kalenderzeiträume."""
    day, mon, m0 = dt.timedelta(days=1), today - dt.timedelta(days=today.weekday()), today.replace(day=1)
    q0 = dt.date(today.year, 3 * ((today.month - 1) // 3) + 1, 1)
    jahr = lambda y: (dt.date(y, 1, 1), dt.date(y + 1, 1, 1))
    return {
        'woche': (mon, mon + 7 * day), 'letzte_woche': (mon - 7 * day, mon), 'vier_wochen': (today - 27 * day, today + day),
        'monat': (m0, _plus_months(m0, 1)), 'letzter_monat': (_plus_months(m0, -1), m0),
        'drei_monate': (_plus_months(today, -3) + day, today + day), 'sechs_monate': (_plus_months(today, -6) + day, today + day),
        'quartal': (q0, _plus_months(q0, 3)), 'vorquartal': (_plus_months(q0, -3), q0),
        'jahr': jahr(today.year), 'letztes_jahr': jahr(today.year - 1), 'vorletztes_jahr': jahr(today.year - 2),
    }


def period_epochs(today):
    """Wie period_ranges, aber als epoch-Sekunden (lokale Mitternacht); plus 'gesamt'."""
    out = {k: [int(time.mktime(d.timetuple())) for d in v] for k, v in period_ranges(today).items()}
    out['gesamt'] = [0, 4_102_444_800]
    return out


def clip(ivs, lo, hi):
    """Schneidet [(von, bis)] auf [lo, hi) zu; leere Reste entfallen."""
    return [(max(a, lo), min(b, hi)) for a, b in ivs if a < hi and b > lo]


def per_day(ivs):
    """Teilt Intervalle an Mitternacht (lokale Zeit) -> {date: [(von, bis) datetime]}."""
    days = {}
    for a, b in ivs:
        a, b = dt.datetime.fromtimestamp(a), dt.datetime.fromtimestamp(b)
        while a < b:
            cut = min(b, dt.datetime.combine(a.date() + dt.timedelta(days=1), dt.time.min))
            days.setdefault(a.date(), []).append((a, cut)); a = cut
    return days


def heute(ivs, now):
    """Kennzahlen des heutigen Tages (Menubar): Blöcke ab lokaler Mitternacht, epoch-Sekunden. laeuft = letzter Block ist noch offen (endet bei now)."""
    lo = int(time.mktime(dt.date.fromtimestamp(now).timetuple()))
    t = clip(ivs, lo, now + 1)
    return {'gesamt_s': sum(b - a for a, b in t), 'sessions': len(t), 'start': t[0][0] if t else None,
            'ende': t[-1][1] if t else None, 'laeuft': bool(t) and t[-1][1] == now}


def selftest():
    r = [(0, 'start'), (300, 'alive'), (400, 'lock'), (500, 'display_on_locked'), (600, 'unlock'),
         (900, 'alive'), (2000, 'alive'), (2100, 'unlock'), (2200, 'sleep'), (3000, 'wake')]
    assert intervals(r, 3100) == [(0, 400), (600, 900), (2100, 2200), (3000, 3100)], intervals(r, 3100)
    assert intervals([(0, 'start')], 10_000) == []  # tot ohne Lebenszeichen: kein Phantom-Block
    assert merge([(0, 100), (399, 500)], 300) == [(0, 500)] and merge([(0, 100), (400, 500)], 300) == [(0, 100), (400, 500)]
    db = sqlite3.connect(':memory:')
    db.execute('CREATE TABLE derived(ts_from, ts_to, source)')
    db.executemany('INSERT INTO derived VALUES (?,?,?)', [(1000, 1000, 'a'), (1500, 1500, 'b'), (5000, 5000, 'a'), (9000, 9100, 'a')])
    assert derived_blocks(db, 9000, 300) == [(700, 1800), (4700, 5300)], derived_blocks(db, 9000, 300)  # Beleg ab cutoff entfällt
    t0 = int(dt.datetime(2025, 3, 3, 9).timestamp()); t1 = int(dt.datetime(2026, 3, 3, 9).timestamp())
    ys = year_stats([(t0, t0 + 1800), (t0 + 86400, t0 + 86400 + 3 * 3600), (t0 + 2 * 86400, t0 + 2 * 86400 + 3600), (t1, t1 + 7200)])
    assert [(y, n, k) for y, n, _, k, _ in ys] == [(2025, 3, 1), (2026, 1, 0)], ys  # genau 1 h zählt nicht als kurz
    assert abs(ys[0][2] - 4.5 / 3) < 1e-9 and abs(ys[0][4] - 2.0) < 1e-9, ys
    assert [k for *_, k, _ in year_stats([(t0, t0 + 1800), (t0 + 86400, t0 + 86400 + 3 * 3600)], 4)] == [2] and year_stats([(t0, t0 + 1800)], 0.4)[0][3] == 0
    D = dt.date
    r = period_ranges(D(2026, 1, 15))  # Donnerstag, direkt nach dem Jahreswechsel
    assert r == {'woche': (D(2026, 1, 12), D(2026, 1, 19)), 'letzte_woche': (D(2026, 1, 5), D(2026, 1, 12)), 'vier_wochen': (D(2025, 12, 19), D(2026, 1, 16)),
                 'monat': (D(2026, 1, 1), D(2026, 2, 1)), 'letzter_monat': (D(2025, 12, 1), D(2026, 1, 1)),
                 'drei_monate': (D(2025, 10, 16), D(2026, 1, 16)), 'sechs_monate': (D(2025, 7, 16), D(2026, 1, 16)),
                 'quartal': (D(2026, 1, 1), D(2026, 4, 1)), 'vorquartal': (D(2025, 10, 1), D(2026, 1, 1)),
                 'jahr': (D(2026, 1, 1), D(2027, 1, 1)), 'letztes_jahr': (D(2025, 1, 1), D(2026, 1, 1)), 'vorletztes_jahr': (D(2024, 1, 1), D(2025, 1, 1))}, r
    r = period_ranges(D(2026, 10, 19))
    assert r['woche'][0] == D(2026, 10, 19) and r['quartal'] == (D(2026, 10, 1), D(2027, 1, 1)) and r['vorquartal'] == (D(2026, 7, 1), D(2026, 10, 1))
    assert period_ranges(D(2026, 3, 31))['drei_monate'][0] == D(2026, 1, 1)  # Monatsende: 31.12. + 1 Tag, kein Überlauf
    assert len(period_epochs(D(2026, 1, 15))) == 13
    assert clip([(0, 10), (20, 30), (40, 50)], 5, 25) == [(5, 10), (20, 25)] and clip([(0, 5)], 5, 9) == []
    m = int(dt.datetime(2026, 3, 3).timestamp()); now = m + 12 * 3600
    assert heute([], now) == {'gesamt_s': 0, 'sessions': 0, 'start': None, 'ende': None, 'laeuft': False}
    assert heute([(m - 3600, m + 3600), (m + 7200, m + 9000)], now) == {'gesamt_s': 5400, 'sessions': 2, 'start': m, 'ende': m + 9000, 'laeuft': False}  # gestern begonnen: ab Mitternacht
    assert heute([(m - 7200, m - 3600), (m + 9 * 3600, now)], now) == {'gesamt_s': 3 * 3600, 'sessions': 1, 'start': m + 9 * 3600, 'ende': now, 'laeuft': True}
    print('selftest ok')


def fmt(h):
    m = round(h * 60)
    return f'{m // 60}:{m % 60:02d}'


if __name__ == '__main__':
    if '--selftest' in sys.argv:
        selftest(); sys.exit()
    kurz = float(sys.argv[sys.argv.index('--kurz') + 1].replace(',', '.')) if '--kurz' in sys.argv else KURZ_H
    gap = float(sys.argv[sys.argv.index('--pause') + 1]) if '--pause' in sys.argv else GAP_MIN
    zr = sys.argv[sys.argv.index('--zeitraum') + 1] if '--zeitraum' in sys.argv else None
    if zr is not None and zr not in period_epochs(dt.date.today()):
        sys.exit(f"--zeitraum {zr!r} unbekannt. Gültig: {', '.join(period_epochs(dt.date.today()))}")
    db = sqlite3.connect(DB)
    rows = db.execute('SELECT ts, event FROM events ORDER BY ts, rowid').fetchall()
    now = int(time.time())
    if '--heute' in sys.argv:  # nur getrackte Daten; --json ist derzeit das einzige Format
        print(json.dumps(heute(merge(intervals(rows, now), gap * 60), now))); sys.exit()
    groups = [('', merge(intervals(rows, now), gap * 60))]
    if '--hergeleitet' in sys.argv:
        groups.insert(0, ('~', derived_blocks(db, rows[0][0] if rows else now, gap * 60)))  # ~ = hergeleitet, nicht getrackt
    alle = []
    for mark, ivs_all in groups:
        if zr:
            ivs_all = clip(ivs_all, *period_epochs(dt.date.today())[zr])
        alle += ivs_all
        for d, ivs in sorted(per_day(ivs_all).items()):
            h = sum((b - a).total_seconds() for a, b in ivs) / 3600
            print(f"{mark}{d} {d.strftime('%a')}  {ivs[0][0]:%H:%M}–{ivs[-1][1]:%H:%M}  {fmt(h):>6} h  {len(ivs)} Blöcke")
            if '--bloecke' in sys.argv:
                for a, b in ivs:
                    print(f'    {a:%H:%M}–{b:%H:%M}')
    print(f'\nJahr   Tage    Ø/Tag   Tage <{kurz:g} h   Ø/Tag ohne diese')
    for y, n, avg, kurz, avg_lang in year_stats(alle, kurz):
        print(f'{y}  {n:>5}  {fmt(avg):>6} h  {kurz:>9}   {fmt(avg_lang):>8} h')
